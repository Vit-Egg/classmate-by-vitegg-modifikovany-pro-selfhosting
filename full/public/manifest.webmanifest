{
  "id": "/dnes",
  "name": "Classmate",
  "short_name": "Classmate",
  "description": "Rozvrh, úkoly, testy a zkoušení, kalendář, známky a poznámky na jednom místě.",
  "lang": "cs",
  "dir": "ltr",
  "start_url": "/dnes?zdroj=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f1013",
  "theme_color": "#0f1013",
  "categories": ["education", "productivity"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Rozvrh", "url": "/rozvrh?zdroj=zkratka", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Úkoly", "url": "/ukoly?zdroj=zkratka", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Testy a zkoušení", "url": "/testy-a-zkouseni?zdroj=zkratka", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Kalendář", "url": "/kalendar?zdroj=zkratka", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/sdilet",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "prefer_related_applications": false
}
