# Veřejná adresa tohohle serveru (adresy widgetů, manifestu a kalendáře), např. https://bakalari.muj-server.cz
PUBLIC_URL=
# Domény, které smí vložit widgety a stáhnout manifest pluginu (čárkou oddělené)
EMBED_ORIGINS=https://classmate.cz
# Šifrovací klíč pro token Bakalářů a heslo Strava.cz (min. 32 znaků). Když chybí, vytvoří se data/.secret
APP_SECRET=
# Kde je databáze
DATA_DIR=./data
# Instalační kód pro první spuštění. Když chybí, vypíše se do logu serveru.
SETUP_TOKEN=
# Jak často (minuty) se stahují data z Bakalářů na pozadí. 0 = vypnuto. Méně než 10 nedoporučuji (šetrnost k serveru školy).
SYNC_MINUTES=15
# Volitelně upozornění přes ntfy (např. https://ntfy.sh/muj-tajny-kanal): nové známky, změny v rozvrhu, zprávy Komens
NTFY_URL=
# Cookies jen přes HTTPS. V LAN přes http nastav false.
COOKIE_SECURE=true
